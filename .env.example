# Template for .env — COPY this file to .env and fill in the real value.
#
#   This file IS committed to git.  .env is NOT (see .gitignore).
#   Anyone cloning the repo can see what settings exist without seeing secrets.

# Get one at https://console.groq.com/keys — no credit card required.
GROQ_API_KEY=gsk_replace_me

# Stub mode (§4.2, §9.6 guardrail 6).
#   1 = canned answers from a fake generator. No network call, no quota spent.
#   0 = real calls to Groq, real tokens off the daily budget.
# Defaults to 1 so a fresh clone can never burn quota by accident.
DOCLYN_STUB=1

# ── Deployment only (§12) ─────────────────────────────────────────────────
# Set to "ephemeral" when the host gives chroma_store/ no persistent disk.
# /health then reports it and the UI warns that uploads reset on restart —
# degraded, but honest. Never ship silently vanishing uploads.
# DOCLYN_PERSISTENCE=ephemeral

# Seed the committed sample corpus at startup when the index is empty.
# Keeps a public demo usable on an ephemeral host.
# DOCLYN_SEED_SAMPLE=1

# Requests per IP per hour against /chat. A public demo spends YOUR quota.
# DOCLYN_RATE_LIMIT=10
