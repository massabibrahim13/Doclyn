# Template for .env — COPY this file to .env and fill in the real value.
#
#   This file IS committed to git.  .env is NOT (see .gitignore).
#   Anyone cloning the repo can see what settings exist without seeing secrets.

# Get one at https://console.groq.com/keys — no credit card required.
GROQ_API_KEY=gsk_replace_me

# Stub mode (§4.2, §9.6 guardrail 6).
#   1 = canned answers from a fake generator. No network call, no quota spent.
#   0 = real calls to Groq, real tokens off the daily budget.
# Defaults to 1 so a fresh clone can never burn quota by accident.
DOCLYN_STUB=1
